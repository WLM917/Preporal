{
  "name": "preporal",
  "version": "1.0.0",
  "private": true,
  "description": "PrepOral — simulateur d'oraux assisté par IA : entretien, Grand Oral, brevet, concours, pitch, certifications de langue.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vercel dev",
    "start": "vercel dev",
    "statique": "npx --yes serve . -l 3000",
    "deploy": "vercel --prod",
    "stripe:ecoute": "stripe listen --forward-to localhost:3000/api/webhook",
    "styles": "tailwindcss -c tailwind.config.cjs -i styles/entree.css -o assets/tailwind.css --minify",
    "styles:watch": "tailwindcss -c tailwind.config.cjs -i styles/entree.css -o assets/tailwind.css --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/supabase-js": "^2.45.4",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "vercel": "^37.0.0"
  },
  "keywords": [
    "oral",
    "grand-oral",
    "entretien",
    "simulateur",
    "ia",
    "saas"
  ],
  "license": "UNLICENSED"
}
