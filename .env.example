# ═══════════════════════════════════════════════════════════
#  Oralixia — variables d'environnement
#  Copiez ce fichier en .env.local et renseignez vos clés.
#  .env.local est ignoré par git : aucune clé ne doit être
#  committée ni figurer dans index.html.
# ═══════════════════════════════════════════════════════════

# ── Modèle d'IA (obligatoire) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Facultatif : surcharge le modèle. Par défaut claude-opus-5.
# claude-sonnet-5 est ~2,5x moins cher en entrée et 2,5x en sortie.
MODELE_IA=claude-opus-5

# ── Stripe (obligatoire pour vendre) ───────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MENSUEL=price_...   # Premium, 9,90 € TTC récurrent mensuel
STRIPE_PRICE_PASS48=price_...    # Pass 48 h, 4,90 € TTC ponctuel
STRIPE_PRICE_EXTRA=price_...     # Extra 6 mois, 54,90 € TTC ponctuel
# true si vous activez Stripe Tax pour le calcul automatique de la TVA
STRIPE_TVA_AUTO=false

# ── Supabase (obligatoire pour les comptes et le quota) ────
SUPABASE_URL=https://xxxx.supabase.co
# Clé service_role : SERVEUR UNIQUEMENT. Elle contourne les
# règles RLS — ne la mettez jamais dans index.html ni dans js/.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── URL publique (facultatif) ──────────────────────────────
# Utilisée pour les URL de retour Stripe. Déduite de la requête
# si absente ; renseignez-la si vous servez plusieurs domaines.
URL_PUBLIQUE=https://votre-domaine.fr

# ── Quota des simulations gratuites ────────────────────────
# Nombre de simulations offertes avant paiement (défaut : 2).
SIMULATIONS_GRATUITES=2

# Valeur par défaut : true — un compte est exigé dès la première
# simulation, et les deux simulations offertes sont rattachées à
# cet identifiant. C'est le seul réglage qui rend le quota gratuit
# réellement infranchissable.
# Mettre false rétablit le quota anonyme par empreinte IP +
# navigateur, que suffisent à contourner un VPN, une fenêtre
# privée ou un autre appareil.
EXIGER_CONNEXION=true

# Sel utilisé pour hacher l'empreinte des visiteurs anonymes.
# À défaut, SUPABASE_SERVICE_ROLE_KEY sert de sel. Changez-le et
# tous les quotas anonymes repartent de zéro.
SEL_EMPREINTE=

# ── Limitation de débit partagée (recommandé en production) ─
# Sans ces deux clés, la limitation retombe sur un compteur en
# mémoire qui se remet à zéro à chaque instance froide.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Modération des avis ────────────────────────────────────
# Jeton d'accès à /moderation.html et à /api/moderation.
# Sans lui, la modération renvoie 503 et aucun avis ne peut être
# publié. Générez-en un long et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLE_MODERATION=

# Jours d'essai offerts sur l'offre six mois (0 pour désactiver).
# Stripe ne débite qu'à la fin de l'essai ; l'accès est accordé
# pendant toute sa durée (statut « trialing »).
ESSAI_EXTRA_JOURS=7

# Échanges quotidiens avec le coach IA hors abonnement.
MESSAGES_COACH_PAR_JOUR=5
